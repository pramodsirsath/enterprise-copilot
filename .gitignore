# Root-level .gitignore — covers all subfolders

# Environment variables (NEVER commit secrets)
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local
